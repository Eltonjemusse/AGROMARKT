generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fixed initial units; no conversion or implied weight for a sack.
enum Unidade {
  kg
  litro
  unidade
  saco
}

enum DadosEstruturadosEstado {
  validado
  pendente_revisao
}

model User {
  id               Int       @id @default(autoincrement())
  nome             String
  email            String    @unique
  senha            String
  telefone         String?
  tipo             String    @default("comprador")
  endereco         String?
  createdAt        DateTime  @default(now())
  pedidosFeitos    Order[]   @relation("BuyerOrders")
  pedidosRecebidos Order[]   @relation("SellerOrders")
  produtos         Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  preco       Float
  quantidade  String
  categoria   String
  imagem      String?
  localizacao String
  userId      Int
  createdAt   DateTime @default(now())
  orders      Order[]
  user        User     @relation(fields: [userId], references: [id])

  // Additive preparation only. No defaults or backfill for existing records.
  quantidadeDisponivel    Decimal?                 @db.Decimal(18, 6)
  unidade                 Unidade?
  precoUnitario           Decimal?                 @db.Decimal(18, 6)
  moeda                   String?                  @db.Char(3)
  dadosEstruturadosEstado DadosEstruturadosEstado?
}

model Order {
  id         Int      @id @default(autoincrement())
  productId  Int
  buyerId    Int
  sellerId   Int
  quantidade String
  total      Float
  status     String   @default("pendente")
  createdAt  DateTime @default(now())
  buyer      User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  seller     User     @relation("SellerOrders", fields: [sellerId], references: [id])

  // Historical snapshots are nullable because legacy values may be unknown.
  quantidadeNumerica      Decimal?                 @db.Decimal(18, 6)
  unidadeSnapshot         Unidade?
  precoUnitarioSnapshot   Decimal?                 @db.Decimal(18, 6)
  moedaSnapshot           String?                  @db.Char(3)
  totalDecimal            Decimal?                 @db.Decimal(30, 2)
  nomeProdutoSnapshot     String?
  // Null on old orders. Set only by atomic acceptance; never backfill.
  stockDescontadoEm        DateTime?
  versaoCalculo           String?
  dadosEstruturadosEstado DadosEstruturadosEstado?

  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
}
